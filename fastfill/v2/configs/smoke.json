{
  "model": {
    "backbone": "tiny",
    "decoder_dim": 32,
    "decoder_heads": 4,
    "decoder_layers": 1,
    "yaw_bins": 12,
    "max_objects": 128,
    "tiny_hidden_size": 32,
    "lora_rank": 0
  },
  "loss": {
    "hungarian": true,
    "position_type": "l1",
    "size_type": "l1",
    "smooth_l1_beta": 1.0
  },
  "training": {
    "steps": 1,
    "batch_size": 1,
    "max_length": 32768,
    "cpu": true,
    "cpu_threads": 2,
    "checkpoint_every": 0,
    "validate_every": 0,
    "resume": null,
    "export_model_every_checkpoint": true
  },
  "optimizer": {
    "warmup_steps": 0,
    "schedule": "cosine",
    "decoder_lr": 0.0001
  },
  "augmentation": {
    "rotate90": true,
    "mirror": false,
    "shuffle_objects": true,
    "drop_constraints_p": 0.3,
    "drop_support_p": 0.2,
    "category_only_description_p": 0.5
  },
  "validation": {
    "exclude_flags": [
      "oob_objects",
      "fixed_collision",
      "overlapping_furniture"
    ]
  }
}
